# Copy this file to .env and fill in your own values. Never upload .env to GitHub.

# Turso database (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-your-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Brevo email (https://www.brevo.com)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=the-sender-address-you-verified-in-brevo@example.com

# Any long random text. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-text
